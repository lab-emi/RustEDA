library (ext_c) {
  delay_model : table_lookup;
  time_unit : "100ps";
  capacitive_load_unit (10, ff);
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";

  input_threshold_pct_rise : 50.0;
  input_threshold_pct_fall : 50.0;
  output_threshold_pct_rise : 50.0;
  output_threshold_pct_fall : 50.0;
  slew_lower_threshold_pct_rise : 20.0;
  slew_upper_threshold_pct_rise : 80.0;
  slew_lower_threshold_pct_fall : 30.0;
  slew_upper_threshold_pct_fall : 70.0;
  slew_derate_from_library : 0.5;
  bus_naming_style : "%s[%d]";

  type (bus2) {
    base_type : array;
    data_type : bit;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0;
    downto : true;
  }

  lu_table_template (t2) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("1.0, 2.0");
    index_2 ("10.0, 20.0");
  }

  cell (ICG_POS) {
    area : 6.0;
    clock_gating_integrated_cell : "latch_posedge";
    statetable ("CLK EN TE", "M0") {
      table : "L L L : - : L, \
               L H - : - : H, \
               L - H : - : H, \
               H - - : - : N";
    }
    pin (CLK) {
      direction : input;
      clock : true;
      clock_gate_clock_pin : true;
      capacitance : 1.0;
    }
    pin (EN) {
      direction : input;
      clock_gate_enable_pin : true;
      capacitance : 0.8;
    }
    pin (TE) {
      direction : input;
      clock_gate_test_pin : true;
      capacitance : 0.8;
    }
    pin (M0) {
      direction : internal;
      internal_node : "M0";
    }
    pin (OBS) {
      direction : output;
      clock_gate_obs_pin : true;
      function : "M0";
    }
    pin (GCLK) {
      direction : output;
      clock_gate_out_pin : true;
      state_function : "(CLK * M0)";
      timing () {
        related_pin : "CLK";
        timing_sense : positive_unate;
        timing_type : combinational_rise;
        when : "EN + TE";
        sdf_cond : "EN == 1'b1 || TE == 1'b1";
        cell_rise (t2) { values ("1.0, 2.0", "3.0, 4.0"); }
        rise_transition (t2) { values ("0.5, 1.0", "1.5, 2.0"); }
      }
      timing () {
        related_pin : "CLK";
        timing_sense : positive_unate;
        timing_type : combinational_fall;
        when : "!EN & !TE";
        sdf_cond : "EN == 1'b0 && TE == 1'b0";
        cell_fall (t2) { values ("1.2, 2.2", "3.2, 4.2"); }
        fall_transition (t2) { values ("0.6, 1.1", "1.6, 2.1"); }
      }
    }
  }

  cell (BUS_BUF) {
    area : 4.0;
    type (bus_up2) {
      base_type : array;
      data_type : bit;
      bit_width : 2;
      bit_from : 0;
      bit_to : 1;
      downto : false;
    }
    bus (A) {
      bus_type : bus2;
      direction : input;
      capacitance : 1.0;
      pin (A[0]) {
        capacitance : 1.5;
      }
    }
    bundle (Y) {
      members (Y0, Y1);
      direction : output;
      max_capacitance : 25.0;
      pin (Y0) {
        function : "A[0]";
        timing () {
          related_pin : "A[0]";
          timing_sense : positive_unate;
          cell_rise (t2) { values ("1.0, 2.0", "3.0, 4.0"); }
          cell_fall (t2) { values ("1.0, 2.0", "3.0, 4.0"); }
          rise_transition (t2) { values ("0.5, 1.0", "1.5, 2.0"); }
          fall_transition (t2) { values ("0.5, 1.0", "1.5, 2.0"); }
        }
      }
      pin (Y1) {
        function : "A[1]";
        max_capacitance : 30.0;
        timing () {
          related_pin : "A[1]";
          timing_sense : positive_unate;
          cell_rise (t2) { values ("1.1, 2.1", "3.1, 4.1"); }
          cell_fall (t2) { values ("1.1, 2.1", "3.1, 4.1"); }
          rise_transition (t2) { values ("0.5, 1.0", "1.5, 2.0"); }
          fall_transition (t2) { values ("0.5, 1.0", "1.5, 2.0"); }
        }
      }
    }
  }
}
