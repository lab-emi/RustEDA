  "generalization_gaps_found": [
    {
      "id": "GAP-1",
      "component": "rustroad floorplan / rusteda frontend-profiles",
      "files": [
        "modules/RustEDA-Common/crates/apps/rusteda-cli/src/flow/helpers.rs",
        "integration/ibex_sg13g2_ez130/native_frontend_inputs.py:265"
      ],
      "summary": "rustroad floorplan omits '\"pin_buses\": {}' when 0 macros exist; rusteda frontend-profiles fails with INPUT error \"'pin_buses'\" unless empty pin_buses/macro_placements dicts are present."
    },
    {
      "id": "GAP-2",
      "component": "compose_native.py / rusteda eco-round --operation reset (fe_eco_reset)",
      "files": [
        "modules/RustEDA-Common/crates/apps/rusteda-cli/src/flow/eco.rs:425-482",
        "integration/ibex_sg13g2_ez130/native_frontend_inputs.py:300-308"
      ],
      "summary": "compose_native.py composes 103 steps with macros: [] cleanly (rc=0, dry-run ok), but fe_eco_reset assumes Ibex topology: >=1000 async-reset sinks, driver.instance.is_some() (rejecting port-driven clk/reset with 'root driven by a port'), and a clock-gating cell from selection.gating_cells driving the primary CK tree."
    },
    {
      "id": "GAP-3",
      "component": "rusteda export -> rustroad import-pdk (Verilog output reg vector bit naming)",
      "files": [
        "modules/RustROAD/crates/rustroad-workspace/src/netlist.rs"
      ],
      "summary": "On bare picorv32 (output reg [31:0] mem_addr), rusteda export emits scalar escaped wire \\mem_addr[0] alongside vector port output [31:0] mem_addr, which rustroad rejects as 'scalar escaped identifier collides with a vector bit name in DEF'. Wrapping picorv32 in picorv32_top prefixes internal nets (\\u_core.mem_addr[0]) and avoids the collision."
    },
    {
      "id": "GAP-4",
      "component": "rustroad hold-eco binding check vs tie-cell fanout cloning",
      "files": [
        "modules/RustROAD/crates/rustroad-workspace/src/eco/binding.rs:593-608",
        "modules/RustROAD/crates/rustroad-workspace/src/physical.rs:894-895"
      ],
      "summary": "binding.rs:593 allows tie cells in --timed-netlist only when --netlist had an Expr::Constant literal, failing with STALE_REPORT on picorv32_top when rustsys emitted a TIELO cell driving fanout>1 that import-pdk cloned into rr_tie_copy_net_* under max_tie_fanout=1. Exporting a pre-CTS Verilog after temp_place works around it cleanly."
    },
    {
      "id": "GAP-5",
      "component": "rustsys (* full_case *) attribute handling",
      "files": [
        "src/picorv32/picorv32.v:402"
      ],
      "summary": "Yosys honors (* full_case *) in picorv32.v (0 latches); RustSys ignores the pragma and infers 68 LATNQX1 latches. Both are proved valid under their respective semantics (RustSys picorv32_top passes check_config+ABC CEC with assume_full_case=False across 2,297 state pairs incl. 68 latches)."
    },
    {
      "id": "GAP-6",
      "component": "rustroad floorplan SKY130A defaults & incremental --prior-diode-plan routing",
      "files": [
        "integration/ibex_pdks/sky130hd/native/physical-clean.json:58,93",
        "integration/ibex_pdks/sky130hd/native/routing-clean.json:84,93,99,145"
      ],
      "summary": "rustroad floorplan defaults io_width=990 (blocking adjacent met3 tracks on high-pin-count designs like 775-pin sha256_core) and target_density_milli=600. Using io_width=400, target_density_milli=300, cell_spacing_sites=3, pin_density_sites_milli=10000 and routing-clean.json reduced SKY130A routing from >2400s timeout to 90-94s with 0 Magic/KLayout DRC. Also, incremental route --prior-workspace --prior-diode-plan stalled >480s with 85 inserted diodes, while fresh route on the exact same moved_existing=0 diode placement succeeded in 105.6s."
    },
    {
      "id": "GAP-7",
      "component": "Shared signoff drivers hardcode Ibex / 1 macro master",
      "files": [
        "integration/ibex_host_benchmark/signoff_layout.py:38-39",
        "integration/ibex_sg13g2_ez130/reference_extract.py:66,81",
        "integration/ibex_sg13g2_ez130/signoff_timing.py:47",
        "integration/ibex_sg13g2_ez130/signoff_logic.py:87-89",
        "integration/ibex_pdks/gates/pdk_signoff.py:136",
        "integration/ibex_sg13g2_ez130/signoff_lvs.py:411"
      ],
      "summary": "High-level signoff wrappers hardcode TOP='ibex_sram_bench', len(macros)==1, and SRAM Liberty/LEF; signoff_lvs.py spawns private systemd-run without AllowedCPUs. Lower-level gates (signoff_drc.py, tap_coverage_runner.py, build_lvs_reference.py, check_lvs.py, magic_drc/magic_antenna/netgen_lvs) already work cleanly with 0 macros and arbitrary top modules."
    },
    {
      "id": "GAP-8",
      "component": "SKY130A horizontal_repair antenna helpers hardcode 2 CPUs and 2 SRAM macros",
      "files": [
        "integration/ibex_pdks/sky130hd/native/horizontal_repair/ranked_metal.py:63",
        "integration/ibex_pdks/sky130hd/native/horizontal_repair/components.py:300"
      ],
      "summary": "ranked_metal.py:63 asserts len(os.sched_getaffinity(0))==2 (fails on 4-CPU allocations unless wrapped with taskset -c); components.py:300 asserts len(fixed_macro_boxes)==2 (blocks generate.py/repair-via-offsets on 0-macro SKY130A designs, leaving 8 residual metal4-contact/metal3 Magic antenna violations on sky130_sha256_core after diode+jumper closure reduced them from 53 to 8)."
    }
  ],
