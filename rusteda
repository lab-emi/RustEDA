#!/usr/bin/env python3
"""RustEDA: design flows and the workspace workbench."""
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent

def main():
    args = sys.argv[1:]
    if not args or args[0] in ("--help", "-h"):
        print("Usage: ./rusteda <command> [options]\n\n  flow       Run, inspect and recover a design flow\n  studio     Open the workspace workbench (--print for text)\n  tools      Configure and verify qualified tools\n  library    Select a standard-cell library\n  sram       Locate SRAM collateral\n\nOther commands inspect and edit design workspaces. Build with ./dev build RustEDA.")
        return 0
    if args[0] in ("flow", "tools", "library", "sram"):
        os.execv(sys.executable, [sys.executable, str(ROOT / "dev"), *args])
    # Workspace commands and the flow controller use one qualified application.
    # Engine-specific backend identities remain separate in the tool inventory.
    toolchain = ROOT / ".work/integration/toolchain.json"
    if toolchain.is_file():
        from integration.toolchain import read_json, verify

        try:
            lock = verify(read_json(toolchain), recovery=True)
            configured = lock["programs"].get("flow_driver")
            if configured is not None:
                os.execv(configured["path"], [configured["path"], *args])
        except (OSError, ValueError, KeyError) as error:
            print(f"Qualified RustEDA application unavailable: {error}", file=sys.stderr)
            return 1
    for profile in ("release", "debug"):
        binary = ROOT / ".work/target/RustEDA" / profile / "rusteda"
        if binary.is_file():
            os.execv(binary, [str(binary), *args])
    print("Build RustEDA first: ./dev build RustEDA --no-default-features", file=sys.stderr)
    return 1

if __name__ == "__main__":
    raise SystemExit(main())
